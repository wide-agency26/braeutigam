# Pooled Postgres URL for the app, and the direct URL Prisma uses for migrations.
# Production: real Supabase project. Vercel Preview: use a separate Supabase branch
# or staging project — never reuse production URLs on Preview (build no longer migrates there).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

# Server-only Supabase Storage credentials. Never prefix these with NEXT_PUBLIC_.
# Keep the private resumes bucket unchanged. Public CMS media uses site-media;
# create it with ops/create-site-media-bucket.sql in the matching environment.
SUPABASE_URL="https://PROJECT.supabase.co"
SUPABASE_SECRET_KEY=

# At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# Seeded on `pnpm db:seed` / first `prisma migrate reset`
ADMIN_EMAIL="admin@braeutigam.local"
ADMIN_PASSWORD="Carbonwerk2016!"

# Set to "true" when the site may be indexed (default: pre-launch noindex).
SITE_INDEXABLE=

# Vercel Cron: Authorization: Bearer <CRON_SECRET> on /api/cron/purge-cvs (production only).
CRON_SECRET=

# Optional Cloudflare Turnstile for job applications (warns in production if missing).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
