# SQLite for local mock data. Switch to a Postgres URL when the remote DB is ready:
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/braeutigam?schema=public"
DATABASE_URL="file:./dev.db"

# At least 32 characters. Generate with: openssl rand -base64 32
SESSION_SECRET="replace-with-a-long-random-secret"

# Seeded on `pnpm db:seed` / first `prisma migrate reset`
ADMIN_EMAIL="admin@braeutigam.local"
ADMIN_PASSWORD="Carbonwerk2016!"
