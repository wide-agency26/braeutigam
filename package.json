{
  "name": "braeutigam-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "sync:typography": "node scripts/generate-typography-tokens.mjs",
    "sync:figma-tokens": "node scripts/sync-figma-tokens.mjs",
    "sync:figma-tokens:docs": "node scripts/sync-figma-tokens.mjs --write-docs",
    "sync:figma-scale": "node scripts/generate-figma-scale-css.mjs",
    "sync:figma-foundation": "pnpm run sync:figma-tokens && pnpm run sync:figma-scale && pnpm run sync:typography",
    "figma:qa": "node scripts/figma-qa.mjs",
    "dev": "pnpm run sync:figma-foundation && next dev",
    "build": "pnpm run sync:figma-foundation && prisma generate && node scripts/migrate-if-production.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node --import tsx prisma/seed.ts"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "esbuild",
      "prisma"
    ]
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@supabase/supabase-js": "2.118.0",
    "bcryptjs": "^3.0.3",
    "framer-motion": "^12.40.0",
    "jose": "^6.2.10",
    "lucide-react": "^1.16.0",
    "next": "16.2.6",
    "ogl": "^1.0.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "server-only": "^0.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "playwright": "^1.58.2",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  }
}
